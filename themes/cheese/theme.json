{
  "name": "Cheese",
  "version": "2.0",
  "author": "Theme designer",
  "description": "Pale Swiss cheese with soft bevels and subtle recessed holes.",
  "colors": {
    "panel_bg": "#fae99f",
    "panel_border": "#b59b55",
    "chart_bg": "#fff4be",
    "chart_grid": "#ddca86",
    "text_primary": "#392a13",
    "text_secondary": "#59451f",
    "text_accent": "#4b3515",
    "krell_track": "#fff4be",
    "krell_indicator": "#79501c",
    "chart_line_default": "#92611d",
    "chart_line_cpu": "#92611d",
    "chart_line_mem": "#79501c",
    "chart_line_swap": "#776b37",
    "chart_line_net_rx": "#92611d",
    "chart_line_net_tx": "#79501c",
    "chart_line_disk": "#92611d",
    "accent_ok": "#376b29",
    "accent_warning": "#8b5316",
    "accent_critical": "#a33126"
  },
  "fonts": {
    "label": {
      "family": "Sans Serif",
      "size": 9,
      "bold": false
    },
    "value": {
      "family": "Sans Serif",
      "size": 10,
      "bold": true
    }
  },
  "metrics": {
    "panel_padding": 6,
    "panel_spacing": 2,
    "panel_border": 0,
    "krell_height": 12,
    "chart_height": 64,
    "chart_grid_lines": 4
  },
  "surfaces": {
    "panel_bg": {
      "image": "assets/panel.png",
      "slice": 6,
      "opacity": 1.0
    },
    "panel_bg_host": {
      "image": "assets/host-panel.png",
      "slice": 6,
      "opacity": 1.0
    },
    "chart_bg": {
      "image": "assets/chart-bg.png",
      "slice": 4,
      "opacity": 1.0
    }
  },
  "images": {
    "chart_bg": {
      "image": "assets/chart-bg.png",
      "mode": "stretch"
    },
    "krell_track": {
      "image": "assets/krell-track.png",
      "mode": "tile"
    },
    "krell": {
      "image": "assets/krell.png",
      "frames": 1
    },
    "frame_top": "assets/frame-top.png",
    "frame_bottom": "assets/frame-bottom.png",
    "frame_left": "assets/frame-left.png",
    "frame_right": "assets/frame-right.png"
  }
}
