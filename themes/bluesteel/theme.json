{
  "name": "Bluesteel",
  "version": "2.0",
  "author": "Theme designer",
  "description": "Muted brushed steel and recessed charcoal charts inspired by Daniel Erat's classic GKrellM BlueSteel.",
  "colors": {
    "panel_bg": "#555e70",
    "panel_border": "#a0aaba",
    "chart_bg": "#20262f",
    "chart_grid": "#404955",
    "text_primary": "#f0f4fa",
    "text_secondary": "#c8d5e4",
    "text_accent": "#f2d478",
    "krell_track": "#20262f",
    "krell_indicator": "#8ecbe8",
    "chart_line_default": "#169bd5",
    "chart_line_cpu": "#169bd5",
    "chart_line_mem": "#19b98a",
    "chart_line_swap": "#8ecbe8",
    "chart_line_net_rx": "#169bd5",
    "chart_line_net_tx": "#19b98a",
    "chart_line_disk": "#169bd5",
    "accent_ok": "#8ee69b",
    "accent_warning": "#f2d478",
    "accent_critical": "#ff8585"
  },
  "fonts": {
    "label": {
      "family": "Sans Serif",
      "size": 9,
      "bold": false
    },
    "value": {
      "family": "Sans Serif",
      "size": 10,
      "bold": true
    }
  },
  "metrics": {
    "panel_padding": 6,
    "panel_spacing": 2,
    "panel_border": 0,
    "krell_height": 12,
    "chart_height": 64,
    "chart_grid_lines": 4
  },
  "surfaces": {
    "panel_bg": {
      "image": "assets/panel.png",
      "slice": 6,
      "opacity": 1.0
    },
    "panel_bg_host": {
      "image": "assets/host-panel.png",
      "slice": 6,
      "opacity": 1.0
    },
    "chart_bg": {
      "image": "assets/chart-bg.png",
      "slice": 4,
      "opacity": 1.0
    }
  },
  "images": {
    "chart_bg": {
      "image": "assets/chart-bg.png",
      "mode": "stretch"
    },
    "krell_track": {
      "image": "assets/krell-track.png",
      "mode": "tile"
    },
    "krell": {
      "image": "assets/krell.png",
      "frames": 1
    },
    "frame_top": "assets/frame-top.png",
    "frame_bottom": "assets/frame-bottom.png",
    "frame_left": "assets/frame-left.png",
    "frame_right": "assets/frame-right.png"
  }
}
