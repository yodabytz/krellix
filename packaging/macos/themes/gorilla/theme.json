{
  "name": "gorilla",
  "version": "1.6",
  "author": "krellix",
  "description": "Classic Gorilla panels and chart artwork for macOS.",
  "surfaces": {
    "panel_bg": {
      "image": "assets/panel.png",
      "slice": 4
    },
    "chart_bg": {
      "image": "assets/chart_bg.png",
      "slice": 4
    },
    "panel_bg_top": {
      "image": "assets/panel-top-new.png",
      "slice": 0,
      "opacity": 1.0
    }
  },
  "images": {
    "chart_bg": "assets/panel.png"
  },
  "colors": {
    "panel_bg": "#E2E3DD",
    "panel_border": "#E2E3DD",
    "panel_highlight": "#44475a",
    "chart_bg": "#343841",
    "chart_grid": "#191a1e",
    "text_meter_bg": "#eeeeec",
    "text_primary": "#000000",
    "text_secondary": "#000000",
    "text_accent": "#ff79c6",
    "krell_track": "#44475a",
    "krell_indicator": "#bd93f7",
    "chart_line_default": "#f5f5f5",
    "chart_line_cpu": "#f5f5f5",
    "chart_line_mem": "#484848",
    "chart_line_swap": "#585858",
    "chart_line_net_rx": "#f5f5f5",
    "chart_line_net_tx": "#d4d4d4",
    "chart_line_disk": "#f5f5f5",
    "accent_warning": "#ffb86c",
    "accent_critical": "#ff5555",
    "accent_ok": "#50fa7b"
  },
  "fonts": {
    "label": {
      "family": "Monospace",
      "size": 9,
      "bold": false
    },
    "value": {
      "family": "Monospace",
      "size": 10,
      "bold": true
    },
    "panel_title": {
      "bold": false
    },
    "time": {
      "family": "Monospace",
      "size": 10,
      "bold": false
    }
  },
  "metrics": {
    "panel_padding": 4,
    "panel_spacing": 2,
    "panel_border": 1,
    "panel_min_width": 100,
    "krell_height": 8,
    "chart_height": 32,
    "chart_grid_lines": 5,
    "chart_grid_width": 1,
    "chart_series_grayscale": 1,
    "top_strip_height": 27
  },
  "text_styles": {
    "text_primary": {
      "color": "#000000",
      "shadow": {
        "x": 2,
        "y": 0,
        "color": "#3d565b5f"
      }
    },
    "text_secondary": {
      "color": "#000000",
      "shadow": {
        "x": 2,
        "y": 0,
        "color": "#3d565b5f"
      }
    },
    "text_accent": {
      "color": "#ff79c6",
      "shadow": {
        "x": 2,
        "y": 0,
        "color": "#3d565b5f"
      }
    },
    "chart_overlay": {
      "color": "#ffffff",
      "shadow": {
        "x": 1,
        "y": 1,
        "color": "#aa000000"
      }
    }
  }
}
