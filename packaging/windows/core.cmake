# Windows GUI and Windows-specific plugins; the Unix daemon is not built here.
target_sources(krellix PRIVATE src/sysdep/WindowsStats.cpp src/sysdep/WindowsSensors.cpp)
target_link_libraries(krellix PRIVATE iphlpapi ws2_32 wtsapi32 psapi)
target_compile_definitions(krellix PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
if(MINGW)
    target_link_options(krellix PRIVATE "-Wl,--export-all-symbols")
endif()
set_target_properties(krellix PROPERTIES WIN32_EXECUTABLE ON
    RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/sensors-candidate")
file(COPY "${CMAKE_SOURCE_DIR}/themes" DESTINATION "${CMAKE_BINARY_DIR}/bin")
add_custom_command(TARGET krellix POST_BUILD
    COMMAND ${CMAKE_COMMAND} -E copy_directory "${CMAKE_SOURCE_DIR}/themes" "$<TARGET_FILE_DIR:krellix>/themes")
set(KRELLIX_SENSOR_DIR "${CMAKE_BINARY_DIR}/sensors" CACHE PATH "Compiled sensor helper and pinned Libre Hardware Monitor libraries")
if(NOT EXISTS "${KRELLIX_SENSOR_DIR}/krellix-sensors.exe")
    message(FATAL_ERROR "Build the Windows sensor helper first using packaging/windows/build-sensors.ps1")
endif()
add_custom_command(TARGET krellix POST_BUILD
    COMMAND ${CMAKE_COMMAND} -E copy_directory "${KRELLIX_SENSOR_DIR}" "$<TARGET_FILE_DIR:krellix>/sensors")

include(CTest)
if(BUILD_TESTING)
    qt_add_executable(windows-sensors tests/windows-sensors.cpp src/sysdep/WindowsSensors.cpp src/sysdep/SensorStat.cpp)
    target_include_directories(windows-sensors PRIVATE src)
    target_link_libraries(windows-sensors PRIVATE Qt6::Core)
    target_compile_definitions(windows-sensors PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
    add_test(NAME windows-sensors COMMAND windows-sensors)
    set_tests_properties(windows-sensors PROPERTIES TIMEOUT 15)
    set(CORE_TEST_SOURCES ${KRELLIX_SOURCES})
    list(REMOVE_ITEM CORE_TEST_SOURCES src/krellix/main.cpp)
    foreach(test IN ITEMS settings-lifecycle windows-core)
        qt_add_executable(${test} tests/${test}.cpp ${CORE_TEST_SOURCES} src/sysdep/WindowsStats.cpp src/sysdep/WindowsSensors.cpp packaging/windows/test-isolation.cpp)
        target_include_directories(${test} PRIVATE src)
        target_link_libraries(${test} PRIVATE Qt6::Widgets Qt6::Network iphlpapi ws2_32 wtsapi32 psapi)
        target_compile_definitions(${test} PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
        if(test STREQUAL "settings-lifecycle")
            add_test(NAME ${test} COMMAND ${test} --monitors clock)
        else()
            add_test(NAME ${test} COMMAND ${test})
        endif()
        set_tests_properties(${test} PROPERTIES ENVIRONMENT "QT_QPA_PLATFORM=offscreen" TIMEOUT 90)
    endforeach()
    add_test(NAME windows-remote-isolation COMMAND windows-core --host 127.0.0.1:19997 --instance remote-isolation)
    set_tests_properties(windows-remote-isolation PROPERTIES ENVIRONMENT "QT_QPA_PLATFORM=offscreen" TIMEOUT 30 RUN_SERIAL TRUE)
    qt_add_executable(remote-reconnect tests/remote-reconnect.cpp
        src/remote/RemoteSource.cpp src/remote/RemoteSource.h
        src/widgets/AlertBanner.cpp src/widgets/AlertBanner.h)
    target_include_directories(remote-reconnect PRIVATE src)
    target_link_libraries(remote-reconnect PRIVATE Qt6::Widgets Qt6::Network)
    add_test(NAME remote-reconnect COMMAND remote-reconnect)
    set_tests_properties(remote-reconnect PROPERTIES ENVIRONMENT "QT_QPA_PLATFORM=offscreen" TIMEOUT 180)
endif()
add_subdirectory("${CMAKE_SOURCE_DIR}/plugins/krelltop/windows" "${CMAKE_BINARY_DIR}/krelltop-windows")
add_subdirectory("${CMAKE_SOURCE_DIR}/plugins/krellhealth/windows" "${CMAKE_BINARY_DIR}/krellhealth-windows")
add_subdirectory("${CMAKE_SOURCE_DIR}/plugins/krellwifi/windows" "${CMAKE_BINARY_DIR}/krellwifi-windows")
add_subdirectory("${CMAKE_SOURCE_DIR}/plugins/krellbluetooth/windows" "${CMAKE_BINARY_DIR}/krellbluetooth-windows")
add_subdirectory("${CMAKE_SOURCE_DIR}/plugins/krellpkg/windows" "${CMAKE_BINARY_DIR}/krellpkg-windows")
add_subdirectory("${CMAKE_SOURCE_DIR}/plugins/krellstack/windows" "${CMAKE_BINARY_DIR}/krellstack-windows")
add_subdirectory("${CMAKE_SOURCE_DIR}/plugins/krellmail/windows" "${CMAKE_BINARY_DIR}/krellmail-windows")
add_subdirectory("${CMAKE_SOURCE_DIR}/plugins/krelldacious/windows" "${CMAKE_BINARY_DIR}/krelldacious-windows")
