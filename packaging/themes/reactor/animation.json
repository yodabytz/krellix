      "frame_width": 228,
      "frame_height": 64,
      "frames": 24,
      "fps": 12,
      "target": "surfaces.panel_bg_host",
      "trigger": "continuous",
      "fallback": "assets/host-panel.png",
      "layout": "horizontal",
      "loop": true
    },
    "left-energy": {
