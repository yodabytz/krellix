{
  "version": 1,
  "animations": {
    "reactor-core": {
      "sheet": "assets/animations/reactor-core.png",
      "frame_width": 228,
      "frame_height": 142,
      "frames": 48,
      "fps": 16,
      "target": "surfaces.panel_bg_top",
      "trigger": "continuous",
      "fallback": "assets/optional-header.png",
      "layout": "horizontal",
      "loop": true,
      "speed": {
        "metric": "cpu_total_percent",
        "min_multiplier": 0.65,
        "max_multiplier": 1.8,
        "smoothing_seconds": 2
      }
    },
    "panel-energy": {
      "sheet": "assets/animations/panel-energy.png",
      "frame_width": 228,
      "frame_height": 96,
      "frames": 24,
      "fps": 12,
