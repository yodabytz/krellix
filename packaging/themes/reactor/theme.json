    "panel_icon_krellweather_haze": "assets/weather/haze.png",
    "panel_icon_krellweather_wind": "assets/weather/windy.png",
    "panel_icon_krellweather_strong_wind": "assets/weather/windy.png",
    "panel_icon_krellweather_thunderstorm": "assets/weather/thunderstorm.png",
    "panel_icon_krellweather_thunderstorm_night": "assets/weather/thunderstorm-night.png",
    "panel_icon_krellweather_severe_thunderstorm": "assets/weather/severe-thunderstorm.png"
