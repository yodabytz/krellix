{
  "name": "carbon-fiber",
  "version": "1.1",
  "author": "yodabytz",
  "description": "Carbon Fiber - dark woven texture with electric blue accents, white labels, green stats and muted gray secondaries.",

  "surfaces": {
    "panel_bg":    { "image": "assets/panel.png",    "opacity": 1.0 },
    "chart_bg":    { "image": "assets/chart_bg.png", "opacity": 1.0 }
  },

  "images": {
    "panel_bg":     { "image": "assets/panel.png",    "mode": "tile" },
    "chart_bg":     { "image": "assets/chart_bg.png", "mode": "tile" },
    "panel_border": { "image": "assets/border.png",   "mode": "stretch" }
  },

  "colors": {
    "panel_bg":           "#0e0e10",
    "panel_border":       "#2a2a2e",
    "panel_highlight":    "#1a1a1d",

    "chart_bg":           "#0e0e10",
    "chart_grid":         "#252528",

    "text_primary":       "#3aa9ff",
    "text_secondary":     "#e6e6e6",
    "text_accent":        "#9ad1ff",

    "krell_track":        "#1c1c20",
    "krell_indicator":    "#3aa9ff",

    "chart_line_default": "#3aa9ff",

    "chart_line_cpu":     "#3aa9ff",
    "chart_line_mem":     "#5ad689",
    "chart_line_swap":    "#b0b0b6",
    "chart_line_net_rx":  "#9ad1ff",
    "chart_line_net_tx":  "#5ad689",
    "chart_line_disk":    "#e6e6e6",

    "accent_warning":     "#f0c674",
    "accent_critical":    "#ff6b6b"
  },

  "text_styles": {
    "text_primary":   { "color": "#3aa9ff", "shadow": { "x": 0, "y": 1, "blur": 2, "color": "#aa000000" } },
    "text_secondary": { "color": "#e6e6e6", "shadow": { "x": 0, "y": 1, "blur": 1, "color": "#80000000" } }
  },

  "fonts": {
    "label": { "family": "Monospace", "size": 9,  "bold": false },
    "value": { "family": "Monospace", "size": 10, "bold": true  }
  },

  "metrics": {
    "panel_padding":    4,
    "panel_spacing":    2,
    "panel_border":     1,
    "panel_min_width":  110,
    "krell_height":     8,
    "chart_height":     70,
    "chart_grid_lines": 5
  }
}
