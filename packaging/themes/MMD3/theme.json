{
  "name": "MMD3",
  "version": "1.4",
  "author": "Theme designer",
  "description": "Sculpted silver and ocean-blue glass, with cyan traces and an animated footer.",
  "colors": {
    "panel_bg": "#00000000",
    "panel_border": "#00000000",
    "chart_bg": "#00000000",
    "text_meter_bg": {
      "gradient": "linear",
      "angle": 90,
      "stops": [
        [0, "#21546d"],
        [1, "#0e354b"]
      ]
    },
    "chart_grid": "#185064",
    "text_primary": "#f2f8fc",
    "text_secondary": "#a5d1e2",
    "text_accent": "#71e8ff",
    "krell_track": "#10384a",
    "krell_indicator": "#35dfff",
    "chart_line_default": "#42caff",
    "chart_line_cpu": "#62eaff",
    "chart_line_mem": "#42caff",
    "chart_line_swap": "#d98aff",
    "chart_line_net_rx": "#40eaff",
    "chart_line_net_tx": "#b1eaff",
    "chart_line_disk": "#70cfff",
    "accent_ok": "#39ee91",
    "accent_warning": "#ffc45b",
    "accent_critical": "#ff6262"
  },
  "fonts": {
    "label": {
      "family": "Arial",
      "size": 9,
      "bold": false
    },
    "value": {
      "family": "Arial",
      "size": 10,
      "bold": true
    }
  },
  "metrics": {
    "panel_padding": 8,
    "panel_padding_left": 10,
    "panel_padding_right": 10,
    "panel_bg_host_padding_bottom": 2,
    "panel_bg_clock_padding_top": 2,
    "panel_spacing": 0,
    "panel_border": 0,
    "krell_height": 12,
    "chart_height": 64,
    "chart_grid_lines": 4,
    "chart_glass": 1,
    "chart_corner_radius": 5,
    "chart_padding_left": 2,
    "chart_padding_right": 2,
    "host_clock_shared_casing": 1,
    "top_strip_height": 47,
    "top_strip_keep_aspect": 1,
    "panel_icon_size": 18,
    "panel_icon_offset_x": 1,
    "panel_icon_spacing": 4,
    "panel_icon_krellhealth_heart_size": 32,
    "panel_icon_krellhealth_status_size": 40
  },
  "surfaces": {
    "panel_bg": {
      "image": "assets/panel.png",
      "slice": 28,
      "mode": "vertical-caps",
      "cap_top": 28,
      "cap_bottom": 28,
      "opacity": 1
    },
    "panel_bg_host": {
      "image": "assets/host-panel.png",
      "slice": 20,
      "mode": "vertical-caps",
      "cap_top": 20,
      "cap_bottom": 20,
      "opacity": 1
    },
    "chart_bg": {
      "image": "assets/chart-bg.png",
      "slice": 0,
      "opacity": 0.0
    },
    "panel_bg_host_clock": {
      "image": "assets/host-panel.png",
      "mode": "vertical-caps",
      "cap_top": 20,
      "cap_bottom": 20
    },
    "panel_bg_clock": {
      "image": "assets/panel-short.png",
      "mode": "vertical-caps",
      "cap_top": 17,
      "cap_bottom": 17
    },
    "panel_bg_proc": {
      "image": "assets/panel-short.png",
      "mode": "vertical-caps",
      "cap_top": 17,
      "cap_bottom": 17
    },
    "panel_bg_uptime": {
      "image": "assets/panel-short.png",
      "mode": "vertical-caps",
      "cap_top": 17,
      "cap_bottom": 17
    },
    "panel_bg_top": {
      "image": "assets/optional-header.png",
      "slice": 0
    }
  },
  "images": {
    "window_bg": "assets/chassis-bg.png",
    "krell_track": {
      "image": "assets/krell-track.png",
      "mode": "tile"
    },
    "krell": {
      "image": "assets/krell.png",
      "frames": 1
    },
    "frame_left": "assets/frame-left.png",
    "frame_right": "assets/frame-right.png",
    "frame_top": "assets/frame-top.png",
    "frame_bottom": {
      "image": "assets/optional-footer.png",
      "mode": "stretch"
    },
    "panel_icon_cpu": "assets/monitor-icons/cpu.png",
    "panel_icon_proc": "assets/monitor-icons/proc.png",
    "panel_icon_mem": "assets/monitor-icons/memory.png",
    "panel_icon_disk": "assets/monitor-icons/disk.png",
    "panel_icon_net": "assets/monitor-icons/network.png",
    "panel_icon_sensors": "assets/monitor-icons/sensors.png",
    "panel_icon_netports": "assets/monitor-icons/ports.png",
    "panel_icon_uptime": "assets/monitor-icons/uptime.png",
    "panel_icon_krellhealth": "assets/monitor-icons/health.png",
    "panel_icon_krellweather": "assets/monitor-icons/weather.png",
    "panel_icon_krellstock": "assets/monitor-icons/stocks.png",
    "panel_icon_krellpkg": "assets/monitor-icons/packages.png",
    "panel_icon_krelltop": "assets/monitor-icons/top.png",
    "panel_icon_krellstock_ticker": "assets/monitor-icons/stocks.png",
    "panel_icon_krellhealth_heart": "assets/health/ok-32.png",
    "panel_icon_krellhealth_status_healthy": "assets/health/ok.png",
    "panel_icon_krellhealth_status_info": "assets/health/info.png",
    "panel_icon_krellhealth_status_warning": "assets/health/warning.png",
    "panel_icon_krellhealth_status_critical": "assets/health/critical.png",
    "panel_icon_krellhealth_status_check": "assets/health/unknown.png"
  }
}
