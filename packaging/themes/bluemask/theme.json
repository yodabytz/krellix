{
  "name": "Bluemask",
  "version": "6.0",
  "author": "Theme designer",
  "description": "Muted lavender charcoal and dusty blue charts inspired by classic GKrellM Bluemask.",
  "colors": {
    "panel_bg": "#414250",
    "panel_border": "#88869e",
    "chart_bg": "#111721",
    "chart_grid": "#343945",
    "text_primary": "#f0f4fa",
    "text_secondary": "#c8d5e4",
    "text_accent": "#9bbde0",
    "krell_track": "#111721",
    "krell_indicator": "#8db4d9",
    "chart_line_default": "#82afd5",
    "chart_line_cpu": "#82afd5",
    "chart_line_mem": "#6396bd",
    "chart_line_swap": "#8db4d9",
    "chart_line_net_rx": "#82afd5",
    "chart_line_net_tx": "#6396bd",
    "chart_line_disk": "#82afd5",
    "accent_ok": "#8ee69b",
    "accent_warning": "#9bbde0",
    "accent_critical": "#ff8585"
  },
  "fonts": {
    "label": {
      "family": "Sans Serif",
      "size": 9,
      "bold": false
    },
    "value": {
      "family": "Sans Serif",
      "size": 10,
      "bold": false
    }
  },
  "metrics": {
    "panel_padding": 3,
    "panel_spacing": 0,
    "panel_border": 0,
    "krell_height": 12,
    "chart_height": 64,
    "chart_grid_lines": 6
  },
  "surfaces": {
    "panel_bg": {
      "image": "assets/panel.png",
      "slice": 6,
      "opacity": 1.0
    },
    "panel_bg_host": {
      "image": "assets/host-panel.png",
      "slice": 6,
      "opacity": 1.0
    },
    "chart_bg": {
      "image": "assets/chart-bg.png",
      "slice": 4,
      "opacity": 1.0
    }
  },
  "images": {
    "chart_bg": {
      "image": "assets/chart-bg.png",
      "mode": "stretch"
    },
    "krell_track": {
      "image": "assets/krell-track.png",
      "mode": "tile"
    },
    "krell": {
      "image": "assets/krell.png",
      "frames": 1
    },
    "frame_top": "assets/frame-top.png",
    "frame_bottom": "assets/frame-bottom.png",
    "frame_left": "assets/frame-left.png",
    "frame_right": "assets/frame-right.png",
    "panel_icon_krellmail": "assets/mail-icon.png",
    "panel_icon_krellmail_unread": {
      "image": "assets/mail-spin.png",
      "frames": 32
    }
  }
}
